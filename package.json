    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  }
