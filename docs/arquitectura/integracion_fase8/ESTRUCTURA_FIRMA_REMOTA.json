  "policies": [
    {
      "cmd": "UPDATE",
      "name": "requests_cancel",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (status = 'cancelled'::text))",
      "roles": [
        "authenticated"
      ],
      "table": "appointment_requests"
    },
    {
      "cmd": "INSERT",
      "name": "requests_create",
      "qual": null,
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (status = 'requested'::text) AND (preferred_date >= CURRENT_DATE) AND (EXISTS ( SELECT 1\n   FROM dentists d\n  WHERE ((d.id = appointment_requests.dentist_id) AND d.is_active))))",
      "roles": [
        "authenticated"
      ],
      "table": "appointment_requests"
    },
    {
      "cmd": "SELECT",
      "name": "requests_read",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "appointment_requests"
    },
    {
      "cmd": "INSERT",
      "name": "photos_create",
      "qual": null,
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (EXISTS ( SELECT 1\n   FROM patient_consents c\n  WHERE ((c.id = dental_photos.consent_id) AND (c.user_id = ( SELECT auth.uid() AS uid)) AND (c.revoked_at IS NULL)))))",
      "roles": [
        "authenticated"
      ],
      "table": "dental_photos"
    },
    {
      "cmd": "DELETE",
      "name": "photos_delete",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "dental_photos"
    },
    {
      "cmd": "SELECT",
      "name": "photos_read",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "dental_photos"
    },
    {
      "cmd": "SELECT",
      "name": "dentists_read",
      "qual": "is_active",
      "check": null,
      "roles": [
        "anon",
        "authenticated"
      ],
      "table": "dentists"
    },
    {
      "cmd": "INSERT",
      "name": "consents_create",
      "qual": null,
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (revoked_at IS NULL))",
      "roles": [
        "authenticated"
      ],
      "table": "patient_consents"
    },
    {
      "cmd": "SELECT",
      "name": "consents_read",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "patient_consents"
    },
    {
      "cmd": "UPDATE",
      "name": "consents_revoke",
      "qual": "(user_id = ( SELECT auth.uid() AS uid))",
      "check": "((user_id = ( SELECT auth.uid() AS uid)) AND (revoked_at IS NOT NULL))",
      "roles": [
        "authenticated"
      ],
      "table": "patient_consents"
    },
    {
      "cmd": "INSERT",
      "name": "profiles_create",
      "qual": null,
      "check": "(id = ( SELECT auth.uid() AS uid))",
      "roles": [
        "authenticated"
      ],
      "table": "profiles"
    },
    {
      "cmd": "SELECT",
      "name": "profiles_read",
      "qual": "(id = ( SELECT auth.uid() AS uid))",
      "check": null,
      "roles": [
        "authenticated"
      ],
      "table": "profiles"
    },
    {
      "cmd": "UPDATE",
      "name": "profiles_update",
      "qual": "(id = ( SELECT auth.uid() AS uid))",
      "check": "(id = ( SELECT auth.uid() AS uid))",
      "roles": [
        "authenticated"
      ],
      "table": "profiles"
    }
  ],
