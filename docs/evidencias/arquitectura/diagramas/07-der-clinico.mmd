        uuid id PK
        uuid encounter_id FK
        text kind
        text title
        date exam_date
        text availability
        text bucket_id
        text object_path
        text mime_type
        bigint size_bytes
        timestamptz created_at
    }
    clinical_clinical_access_grants {
        uuid id PK
        uuid patient_id FK
        uuid membership_id FK
        text purpose
        text policy_version
        timestamptz granted_at
        timestamptz expires_at
        timestamptz revoked_at
        text scope_mode
    }
    clinical_clinical_grant_resources {
        uuid grant_id PK
        uuid encounter_id PK
    }
    clinical_clinical_access_audit {
        uuid id PK
        uuid request_id
        uuid actor_user_id FK
        uuid patient_id FK
        uuid membership_id FK
        uuid grant_id FK
        text operation
        text outcome
        text reason_code
        timestamptz occurred_at
    }
