        uuid id PK
        uuid patient_id FK
        uuid membership_id FK
        timestamptz attended_at
        timestamptz recorded_at
        text status
        uuid replaces_id FK
    }
    clinical_clinical_entries {
        uuid id PK
        uuid encounter_id FK
        text kind
