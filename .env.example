# LLM educativo (server-only): configura OPENAI_API_KEY como secreto y OPENAI_MODEL como modelo habilitado.
# No uses NEXT_PUBLIC_OPENAI_API_KEY ni guardes la clave en este archivo.

# Smile server-only variables; never prefix these with NEXT_PUBLIC_.
# Smile V17 authorizes confirmed, active patients and superadministrators from
# Auth app_metadata.dentaia. No UUID allowlist is required.
# OPENAI_API_KEY and OPENAI_MODEL are server-only. Explanations additionally require shared Upstash REST limiting.
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are server-only; allow 5 explanations per user / 10 minutes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configuración pública del proyecto académico. Copiar a .env.local.
# Esta clave publicable NO permite administrar Supabase ni evita las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://vwmdknzjyvmsdqpepykz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XvoEj81AUzWauvWm0Wegqg_-G-Y8zRe

# Escrituras administrativas: activar solo para desarrollo local controlado o Vercel Preview/develop.
# Production queda denegado por las comprobaciones de entorno del servidor.
DENTAIA_LOCATION_WRITES_ENABLED=false
DENTAIA_ADMIN_WORKFLOWS_ENABLED=false
# API local de DentaIA Smile. Nunca uses NEXT_PUBLIC para esta variable.
# En Vercel Preview, usar un destino HTTPS y activar solo en la rama indicada:
# DENTAIA_SMILE_PREVIEW_ENABLED=true (scope Preview, no Production).
DENTAIA_SMILE_API_URL=http://127.0.0.1:7862/analyze
DENTAIA_SMILE_PREVIEW_ENABLED=false
# Production remains closed unless this exact server-only opt-in is true.
DENTAIA_SMILE_PRODUCTION_ENABLED=false
# Required in Vercel Preview and the separate Smile service: same server-only random value (32+ characters).
# Leave unset only for the loopback-only local FastAPI process.
DENTAIA_SMILE_SERVICE_SECRET=
# Solo el proceso FastAPI local lee esta clave de Roboflow; nunca la expongas al navegador.
ROBOFLOW_API_KEY=
