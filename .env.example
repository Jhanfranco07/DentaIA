# LLM educativo (server-only): configura OPENAI_API_KEY como secreto y OPENAI_MODEL como modelo habilitado.
# No uses NEXT_PUBLIC_OPENAI_API_KEY ni guardes la clave en este archivo.

# Vision server-only variables; never prefix these with NEXT_PUBLIC_.
# DENTAL_VISION_API_URL is the full /predict endpoint URL.
# If unset, development alone defaults to http://127.0.0.1:10000/predict.
# Non-development environments require an HTTPS URL.
# DENTAL_VISION_SERVICE_SECRET must be set in the server environment (ASCII, at least 32 bytes).
# Do not store the secret value in this file.
# DENTAL_VISION_ALLOWED_USER_IDS: comma-separated Supabase user UUIDs authorized for the demo.
# The server verifies every bearer session against Supabase Auth and this allowlist; unset/invalid denies access.
# OPENAI_API_KEY and OPENAI_MODEL are server-only. Explanations additionally require shared Upstash REST limiting.
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are server-only; allow 5 explanations per user / 10 minutes.
DENTAL_VISION_ALLOWED_USER_IDS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configuración pública del proyecto académico. Copiar a .env.local.
# Esta clave publicable NO permite administrar Supabase ni evita las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://vwmdknzjyvmsdqpepykz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XvoEj81AUzWauvWm0Wegqg_-G-Y8zRe

# Escrituras administrativas: activar solo para desarrollo local controlado o Vercel Preview/develop.
# Production queda denegado por las comprobaciones de entorno del servidor.
DENTAIA_LOCATION_WRITES_ENABLED=false
DENTAIA_ADMIN_WORKFLOWS_ENABLED=false

# Stripe Sandbox: valores secretos solo en el entorno seguro del servidor.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
